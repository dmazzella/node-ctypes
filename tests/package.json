{
  "name": "node-ctypes-tests",
  "version": "0.1.0",
  "description": "Test suite for node-ctypes",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm --prefix .. run build:test-fixture",
    "test": "npm run test:js",
    "test:js": "node --test --test-timeout=5000 \"cpython_parity/**/test_*.js\" \"node_specific/**/test_*.js\"",
    "test:windows": "node --test --test-timeout=5000 \"cpython_parity/platform/test_winapi.js\" \"node_specific/test_winapi_convenience.js\"",
    "test:parity:check": "node check_parity.js",
    "test:parity": "npm run test:parity:python && npm run test:parity:js",
    "test:parity:js": "node --test --test-timeout=5000 \"cpython_parity/**/test_*.js\"",
    "test:parity:python": "node check_parity.js --python-parity",
    "test:node": "node --test --test-timeout=5000 \"node_specific/**/test_*.js\"",
    "test:python": "node check_parity.js --python",
    "bench:koffi": "node benchmarks/benchmark_koffi.js",
    "bench:ffi": "node --experimental-ffi benchmarks/benchmark_node_ffi.js",
    "bench:python": "python benchmarks/benchmark_python.py"
  },
  "dependencies": {
    "node-ctypes": "file:.."
  },
  "devDependencies": {
    "koffi": "^3.3.4"
  },
  "allowScripts": {
    "koffi@3.3.4": true
  }
}
